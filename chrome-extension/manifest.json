{
  "manifest_version": 3,
  "name": "Review Generator Auto-Fill",
  "version": "1.0",
  "description": "Automatically fills 5 stars and text on Google Reviews when launched from the Review Generator app.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-webapp.js"]
    },
    {
      "matches": ["*://*.google.com/*"],
      "js": ["content-google.js"]
    }
  ]
}
