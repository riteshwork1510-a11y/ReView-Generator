# Backend Environment Variables Example
# Do not put actual passwords here. Copy this file to .env and fill in the real values.

# MongoDB Connection String (Replace with your actual MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appname>

# Database Name
MONGODB_DATABASE=ai_review_generator

# Frontend Origin (Change this to your deployed Next.js URL on production, e.g., https://your-app.vercel.app)
FRONTEND_ORIGIN=http://localhost:3000
